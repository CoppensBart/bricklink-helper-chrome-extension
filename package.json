{
  "name": "bhce",
  "version": "1.0.1",
  "private": true,
  "dependencies": {
    "antd": "^5.24.2",
    "arrive": "^2.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "cpy-cli": "^7.0.0",
    "parcel": "^2.0.0",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "clean-build": "rimraf build && mkdir build",
    "copy-public": "cpy public/**/* build --parents",
    "init": "yarn run clean-build && yarn run copy-public",
    "build": "yarn run init && parcel build src/index.js --dist-dir build --no-source-maps"
  }
}
